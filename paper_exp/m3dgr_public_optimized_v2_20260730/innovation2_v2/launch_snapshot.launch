<launch>
  <!--
    M3DGR MID-360 rosbag adapter. The bag contains CustomMsg, /odom and
    optional external truth, but no /tf. The static transform below is composed
    from the official M3DGR mid360 -> camera_imu and wheel -> camera_imu
    calibrations. In the bag, wheel is represented by base_footprint.
  -->
  <arg name="input_topic" default="/livox/mid360/lidar"/>
  <arg name="cloud_topic" default="/velodyne_points"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="publish_official_extrinsic" default="true"/>
  <arg name="start_cartographer" default="true"/>
  <arg name="start_local_grid" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="cartographer_config_dir" default="$(find my_navigation)/config"/>
  <arg name="cartographer_config" default="cartographer_m3dgr_mid360.lua"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="my_navigation" type="livox_custommsg_to_pointcloud2"
        name="m3dgr_mid360_custommsg_to_pointcloud2" output="screen">
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="output_topic" value="$(arg cloud_topic)"/>
  </node>

  <!-- Official calibration source:
       https://github.com/sjtuyinjie/M3DGR/blob/main/calibration.md
       wheel_T_mid360 = inverse(body_T_wheel) * body_T_mid360. -->
  <node if="$(arg publish_official_extrinsic)" pkg="tf2_ros"
        type="static_transform_publisher" name="m3dgr_base_to_mid360"
        args="-0.063742232981 1.003639208011 0.417493046931
              -0.014813385023 0.255990978057 -0.028832269454 0.966135540706
              base_footprint livox_frame"/>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="m3dgr_mid360_cloud_to_scan" output="screen">
    <remap from="cloud_in" to="$(arg cloud_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="target_frame" value="base_footprint"/>
    <param name="transform_tolerance" value="0.10"/>
    <param name="min_height" value="0.20"/>
    <param name="max_height" value="0.60"/>
    <param name="angle_min" value="-3.1415926"/>
    <param name="angle_max" value="3.1415926"/>
    <param name="angle_increment" value="0.0043633"/>
    <param name="scan_time" value="0.10"/>
    <param name="range_min" value="0.30"/>
    <param name="range_max" value="30.0"/>
    <param name="use_inf" value="true"/>
    <param name="inf_epsilon" value="1.0"/>
  </node>

  <group if="$(arg start_cartographer)">
    <node name="cartographer_node" pkg="cartographer_ros"
          type="cartographer_node" output="screen"
          args="-configuration_directory $(arg cartographer_config_dir)
                -configuration_basename $(arg cartographer_config)">
      <remap from="scan" to="$(arg scan_topic)"/>
      <remap from="odom" to="$(arg odom_topic)"/>
    </node>
    <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
          type="cartographer_occupancy_grid_node" output="screen"
          args="-resolution 0.05 -publish_period_sec 1.0"/>
  </group>

  <node if="$(arg start_local_grid)" pkg="my_navigation"
        type="local_grid_mapper" name="local_grid_mapper" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="output_topic" value="/local_occupancy_grid"/>
    <param name="map_output_topic" value="/local_occupancy_grid_map"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="map_frame" value="map"/>
    <param name="publish_map_frame_grid" value="true"/>
    <param name="map_size" value="5.0"/>
    <param name="resolution" value="0.05"/>
    <param name="max_range" value="5.0"/>
    <param name="tf_timeout" value="0.10"/>
    <param name="obstacle_dilation_cells" value="1"/>
  </node>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find my_navigation)/rviz/mapping_local_grid.rviz"/>
</launch>
