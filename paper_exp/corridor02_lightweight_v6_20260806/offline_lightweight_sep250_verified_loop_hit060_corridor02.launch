<launch>
  <!--
    Require repeated obstacle hits in the published global map, while keeping
    the historical free-space update strength used by this one-grid rebuild.
    No localization or pose-graph parameter differs from the frozen profile.
  -->
  <include file="/home/slam/slam_ws/paper_exp/corridor02_lightweight_v6_20260806/offline_lightweight_sep250_verified_loop_corridor02.launch"/>
  <param name="/lightweight_2d_slam/global_map_hit_probability" value="0.60"/>
  <param name="/lightweight_2d_slam/global_map_miss_probability" value="0.4013123399"/>
  <param name="/lightweight_2d_slam/global_map_hit_connection_max_distance" value="0.0"/>
</launch>
