<launch>
  <!--
    Map-rendering ablation only. Match the inverse sensor probabilities used
    by the same-input Cartographer baseline while leaving scan matching,
    submaps, local mapping, pose-graph constraints, and trajectory unchanged.
  -->
  <include file="/home/slam/slam_ws/paper_exp/corridor02_lightweight_v6_20260806/offline_lightweight_sep250_verified_loop_corridor02.launch"/>
  <param name="/lightweight_2d_slam/global_map_hit_probability" value="0.60"/>
  <param name="/lightweight_2d_slam/global_map_miss_probability" value="0.49"/>
  <param name="/lightweight_2d_slam/global_map_hit_connection_max_distance" value="0.0"/>
</launch>
