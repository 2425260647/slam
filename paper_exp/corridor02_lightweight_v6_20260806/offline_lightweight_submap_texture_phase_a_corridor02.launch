<launch>
  <!--
    Phase A changes only global-map rendering. Tracking, loop closure and the
    rigid submap pose graph are inherited unchanged from the verified V2.
    Weak probability updates require repeated support before an endpoint is
    rendered as an occupied wall cell.
  -->
  <include file="/home/slam/slam_ws/paper_exp/corridor02_lightweight_v6_20260806/offline_lightweight_prediction_prior_rigid_corridor02.launch"/>
  <param name="/lightweight_2d_slam/global_map_hit_probability" value="0.55"/>
  <param name="/lightweight_2d_slam/global_map_miss_probability" value="0.49"/>
  <param name="/lightweight_2d_slam/global_map_hit_connection_max_distance"
         value="0.0"/>
</launch>
