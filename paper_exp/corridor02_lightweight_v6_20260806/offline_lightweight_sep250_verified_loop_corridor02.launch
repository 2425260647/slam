<launch>
  <!--
    Evidence-driven long-range loop profile. Candidate diagnostics showed
    that 0.64 retains the repeated start/end match while the 250-keyframe
    exclusion removes locally repeated corridor segments. Sequence and
    temporal confirmation remain mandatory before a full SE(2) edge is added.
  -->
  <include file="/home/slam/slam_ws/paper_exp/corridor02_lightweight_v6_20260806/offline_lightweight_multiscale_temporal_corridor02.launch"/>
  <param name="/lightweight_2d_slam/loop_min_match_score" value="0.64"/>
  <param name="/lightweight_2d_slam/loop_use_switchable_constraints" value="false"/>
  <param name="/lightweight_2d_slam/loop_log_candidate_evaluations" value="false"/>
  <param name="/lightweight_2d_slam/global_correction_blend_duration" value="10.0"/>
  <param name="/lightweight_2d_slam/map_publish_period" value="0.5"/>
</launch>
