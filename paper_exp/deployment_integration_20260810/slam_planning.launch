<launch>
  <arg name="configuration_directory" default="$(dirname)"/>
  <arg name="configuration_basename"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="local_costmap_frame" default="odom"/>
  <arg name="publish_identity_base_tf" default="false"/>
  <arg name="base_parent_frame" default="base_footprint"/>
  <arg name="base_child_frame" default="base_link"/>
  <arg name="use_sim_time" default="true"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node if="$(arg publish_identity_base_tf)" pkg="tf2_ros"
        type="static_transform_publisher" name="deployment_base_footprint_to_base_link"
        args="0 0 0 0 0 0 $(arg base_parent_frame) $(arg base_child_frame)"/>

  <node pkg="cartographer_ros" type="cartographer_node"
        name="cartographer_node" output="screen"
        args="-configuration_directory $(arg configuration_directory)
              -configuration_basename $(arg configuration_basename)">
    <remap from="scan" to="$(arg scan_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>

  <node pkg="cartographer_ros" type="cartographer_occupancy_grid_node"
        name="cartographer_occupancy_grid_node" output="screen"
        args="-resolution 0.05 -publish_period_sec 1.0"/>

  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" respawn="false">
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="GlobalPlanner/use_dijkstra" value="false"/>
    <param name="GlobalPlanner/allow_unknown" value="true"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
    <param name="planner_frequency" value="1.0"/>
    <param name="controller_frequency" value="5.0"/>

    <param name="global_costmap/global_frame" value="map"/>
    <param name="global_costmap/robot_base_frame" value="base_link"/>
    <param name="global_costmap/static_map" value="true"/>
    <param name="global_costmap/rolling_window" value="false"/>
    <param name="global_costmap/update_frequency" value="1.0"/>
    <param name="global_costmap/publish_frequency" value="1.0"/>
    <param name="global_costmap/observation_sources" value="scan"/>
    <param name="global_costmap/scan/topic" value="$(arg scan_topic)"/>
    <param name="global_costmap/scan/data_type" value="LaserScan"/>
    <param name="global_costmap/scan/marking" value="true"/>
    <param name="global_costmap/scan/clearing" value="true"/>

    <param name="local_costmap/global_frame" value="$(arg local_costmap_frame)"/>
    <param name="local_costmap/robot_base_frame" value="base_link"/>
    <param name="local_costmap/rolling_window" value="true"/>
    <param name="local_costmap/width" value="6.0"/>
    <param name="local_costmap/height" value="6.0"/>
    <param name="local_costmap/resolution" value="0.05"/>
    <param name="local_costmap/update_frequency" value="5.0"/>
    <param name="local_costmap/publish_frequency" value="2.0"/>
    <param name="local_costmap/observation_sources" value="scan"/>
    <param name="local_costmap/scan/topic" value="$(arg scan_topic)"/>
    <param name="local_costmap/scan/data_type" value="LaserScan"/>
    <param name="local_costmap/scan/marking" value="true"/>
    <param name="local_costmap/scan/clearing" value="true"/>

    <param name="TebLocalPlannerROS/acc_lim_x" value="0.5"/>
    <param name="TebLocalPlannerROS/acc_lim_theta" value="1.0"/>
    <param name="TebLocalPlannerROS/max_vel_x" value="0.5"/>
    <param name="TebLocalPlannerROS/max_vel_theta" value="0.8"/>
    <param name="TebLocalPlannerROS/footprint_model/type" value="circular"/>
    <param name="TebLocalPlannerROS/footprint_model/radius" value="0.5"/>
    <param name="TebLocalPlannerROS/dt_ref" value="0.3"/>
    <param name="TebLocalPlannerROS/global_plan_overwrite_orientation" value="true"/>
  </node>

  <node pkg="nav_driver" type="my_navigation" name="navigation_driver"
        output="screen">
    <param name="camera_offset_x" value="0.32"/>
    <param name="stop_distance" value="1.0"/>
    <param name="object_timeout" value="5.0"/>
    <param name="exploration_frequency" value="0.5"/>
    <param name="frontier_min_dist" value="0.5"/>
  </node>

  <node pkg="my_navigation" type="local_grid_mapper"
        name="local_grid_mapper" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="output_topic" value="/local_occupancy_grid"/>
    <param name="map_output_topic" value="/local_occupancy_grid_map"/>
    <param name="base_frame" value="base_link"/>
    <param name="map_frame" value="map"/>
    <param name="publish_map_frame_grid" value="true"/>
    <param name="map_size" value="5.0"/>
    <param name="resolution" value="0.05"/>
    <param name="max_range" value="5.0"/>
    <param name="obstacle_dilation_cells" value="1"/>
  </node>
</launch>
