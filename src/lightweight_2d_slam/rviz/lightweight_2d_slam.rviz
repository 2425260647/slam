Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Global Map
      Topic: /map
      Use Timestamp: false
    - Class: rviz/Map
      Alpha: 0.40
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Map
      Topic: /local_occupancy_grid
      Use Timestamp: false
    - Class: rviz/LaserScan
      Enabled: true
      Name: Scan
      Size (m): 0.03
      Style: Points
      Topic: /scan
    - Class: rviz/Path
      Color: 1; 0.4; 0.1
      Enabled: true
      Name: Tracked Path
      Topic: /lightweight_slam/path
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.5
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Angle: 0
      Scale: 20
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
