<launch>
  <arg name="config"
       default="$(find lightweight_2d_slam)/config/gazebo_playpen.yaml"/>
  <include file="$(find lightweight_2d_slam)/launch/offline_lightweight_slam.launch">
    <arg name="config" value="$(arg config)"/>
    <!-- Keep the V6 candidate gate and let graph consistency set loop weight. -->
    <arg name="loop_min_score_margin" value="0.03"/>
    <arg name="loop_min_confirmations" value="2"/>
    <arg name="loop_min_keyframes_between_accepts" value="30"/>
    <arg name="loop_reject_low_observability_large_correction" value="false"/>
    <arg name="loop_use_switchable_constraints" value="true"/>
    <arg name="loop_switch_prior_weight" value="25.0"/>
  </include>
</launch>
