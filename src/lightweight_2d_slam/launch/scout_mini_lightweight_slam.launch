<launch>
  <arg name="gui" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="world_name" default="$(find scout_gazebo_sim)/worlds/clearpath_playpen.world"/>
  <arg name="config" default="$(find lightweight_2d_slam)/config/gazebo_playpen.yaml"/>
  <arg name="enable_loop_closure" default="true"/>

  <!-- Gazebo, Scout Mini, /odom and robot_state_publisher. -->
  <include file="$(find scout_gazebo_sim)/launch/scout_mini_diff_drive_empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Keep the existing simulation sensor adapter. No Cartographer is started. -->
  <node pkg="scout_gazebo_sim" type="pointcloud_to_pointcloud2.py"
        name="lightweight_sim_cloud_converter" output="screen">
    <param name="input" value="/velodyne_points_raw"/>
    <param name="output" value="/velodyne_points"/>
  </node>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="lightweight_sim_cloud_to_scan" output="screen">
    <remap from="cloud_in" to="/velodyne_points"/>
    <remap from="scan" to="/scan"/>
    <param name="target_frame" value="laser_link"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="-0.35"/>
    <param name="max_height" value="1.6"/>
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.00872"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="0.30"/>
    <param name="range_max" value="25.0"/>
  </node>

  <node pkg="lightweight_2d_slam" type="lightweight_2d_slam_node"
        name="lightweight_2d_slam" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="enable_loop_closure" value="$(arg enable_loop_closure)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find lightweight_2d_slam)/rviz/lightweight_2d_slam.rviz"/>
</launch>
