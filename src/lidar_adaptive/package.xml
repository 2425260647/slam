<?xml version="1.0"?>
<package format="2">
  <name>lidar_adaptive</name>
  <version>0.1.0</version>
  <description>Confidence-aware 16-beam LiDAR projection and information-driven scan selection for Cartographer experiments.</description>

  <maintainer email="slam@todo.todo">slam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>my_navigation</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rosbag</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export>
  </export>
</package>
