<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="corridor_elevator">
    <!-- 120 m x 3 m repetitive corridor with a 2.4 m wide, 3.4 m deep
         elevator alcove on the positive-y wall at x=0. -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.70 0.78 0.86 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- The left wall is split around the 2.4 m elevator entrance. -->
    <model name="left_wall_before_elevator">
      <static>true</static><pose>-30.6 1.6 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>57.6 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>57.6 0.2 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="left_wall_after_elevator">
      <static>true</static><pose>30.6 1.6 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>57.6 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>57.6 0.2 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="right_wall">
      <static>true</static><pose>0 -1.6 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>120.0 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>120.0 0.2 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="front_end_wall">
      <static>true</static><pose>60.1 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="back_end_wall">
      <static>true</static><pose>-60.1 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></visual>
      </link>
    </model>

    <!-- Elevator alcove: entrance spans x=[-1.2,1.2], depth y=1.6..5.0. -->
    <model name="elevator_left_return">
      <static>true</static><pose>-1.2 3.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="elevator_right_return">
      <static>true</static><pose>1.2 3.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3.4 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="elevator_back_wall">
      <static>true</static><pose>0 5.0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.6 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.2 2.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="elevator_door_left">
      <static>true</static><pose>-0.55 4.87 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.06 2.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.06 2.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="elevator_door_right">
      <static>true</static><pose>0.55 4.87 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.06 2.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.06 2.2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
