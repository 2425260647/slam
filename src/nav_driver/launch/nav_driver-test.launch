<launch>
    <param name="/use_sim_time" value="true"/>
    <!-- Simulation smoke-test entry point. The production navigation stack is
         shared verbatim so simulation and real-robot tuning cannot drift. -->
    <node pkg="nav_driver" type="sim_env" name="sim_env" output="screen"/>
    <include file="$(find nav_driver)/launch/nav_driver.launch">
        <arg name="publish_camera_tf" value="false"/>
        <arg name="use_sim_time" value="true"/>
    </include>
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find nav_driver)/rviz/nav_driver_sim.rviz"/>
</launch>
