<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="long_corridor">
    <!--
      Long corridor SLAM test world.

      Purpose:
      - Build a very long, visually and geometrically repetitive corridor.
      - Stress-test Cartographer 2D in a degenerate environment where the two
        side walls look the same for a long distance.
      - Let RViz show whether /map walls stay parallel, become duplicated, or
        slowly bend during long straight motion.

      Geometry:
      - Inner corridor width: 3.0 m.
      - Corridor length: 120.0 m.
      - Wall height: 2.4 m.
      - Both side walls use identical dimensions and material.

      Important:
      This world is intentionally difficult for pure laser SLAM. If the map
      drifts along the corridor direction, that is a useful test result, not
      automatically a Gazebo world error.
    -->

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Use Gazebo's built-in ground plane instead of a custom long box floor.

      The previous custom floor was a large box model. In this workspace it was
      observed in /gazebo/model_states at z ~= -3.5 together with the robot,
      which made the lidar scan return many max-range values and appear as a
      huge circle in RViz. The built-in ground_plane is the standard, stable
      choice for a flat Gazebo floor and avoids that failure mode.
    -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.70 0.78 0.86 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-8 -10 9 0 0.75 0.82</pose>
      </camera>
    </gui>

    <!-- Left wall. Inner face is at y = +1.5 m. -->
    <model name="left_wall">
      <static>true</static>
      <pose>0 1.6 1.2 0 0 0</pose>
      <link name="left_wall_link">
        <collision name="left_wall_collision">
          <geometry>
            <box>
              <size>120.0 0.2 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="left_wall_visual">
          <geometry>
            <box>
              <size>120.0 0.2 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right wall. Same size and material as the left wall. Inner face is at y = -1.5 m. -->
    <model name="right_wall">
      <static>true</static>
      <pose>0 -1.6 1.2 0 0 0</pose>
      <link name="right_wall_link">
        <collision name="right_wall_collision">
          <geometry>
            <box>
              <size>120.0 0.2 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="right_wall_visual">
          <geometry>
            <box>
              <size>120.0 0.2 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- End walls close the corridor far away from the robot's usual start pose. -->
    <model name="front_end_wall">
      <static>true</static>
      <pose>60.1 0 1.2 0 0 0</pose>
      <link name="front_end_wall_link">
        <collision name="front_end_wall_collision">
          <geometry>
            <box>
              <size>0.2 3.4 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="front_end_wall_visual">
          <geometry>
            <box>
              <size>0.2 3.4 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="back_end_wall">
      <static>true</static>
      <pose>-60.1 0 1.2 0 0 0</pose>
      <link name="back_end_wall_link">
        <collision name="back_end_wall_collision">
          <geometry>
            <box>
              <size>0.2 3.4 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="back_end_wall_visual">
          <geometry>
            <box>
              <size>0.2 3.4 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
