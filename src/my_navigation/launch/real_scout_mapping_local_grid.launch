<launch>
  <arg name="enable_monitor" default="true"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="cloud_topic" default="/velodyne_points"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="cartographer_scan_topic" default="/scan_cartographer"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="target_frame" default="base_link"/>
  <!-- Height limits are evaluated in target_frame.  Transforming into
       base_link makes the filter independent of the laser mounting height;
       0.20 to 0.60 m keeps walls/obstacles and rejects downward floor returns,
       chassis reflections and high mast/ceiling points. -->
  <arg name="min_height" default="0.20"/>
  <arg name="max_height" default="0.60"/>
  <arg name="range_min" default="0.30"/>
  <arg name="range_max" default="30.0"/>
  <arg name="cartographer_config_dir" default="$(find my_navigation)/config"/>
  <!-- Real Scout bringup supplies odom->base_link. Cartographer publishes
       only map->odom in this configuration, avoiding duplicate TF edges. -->
  <arg name="cartographer_config" default="cartographer_scout_online_navigation.lua"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Start the Scout base and LiDAR driver separately. This launch owns only
       point-cloud projection, mapping/localization and occupancy grids. -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="real_cloud_to_scan" output="screen">
    <remap from="cloud_in" to="$(arg cloud_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="$(arg min_height)"/>
    <param name="max_height" value="$(arg max_height)"/>
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.00436"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="$(arg range_min)"/>
    <param name="range_max" value="$(arg range_max)"/>
    <param name="use_inf" value="true"/>
  </node>

  <!-- Keep the raw scan unchanged for collision avoidance.  Only Cartographer
       receives finite no-return sentinels, which it converts into 5 m misses
       because its configured max_range remains 30.0 m. -->
  <node pkg="my_navigation" type="cartographer_scan_adapter"
        name="cartographer_scan_adapter" output="screen">
    <param name="input_topic" value="$(arg scan_topic)"/>
    <param name="output_topic" value="$(arg cartographer_scan_topic)"/>
    <param name="no_return_epsilon" value="0.10"/>
  </node>

  <node name="cartographer_node" pkg="cartographer_ros"
        type="cartographer_node" output="screen"
        args="-configuration_directory $(arg cartographer_config_dir)
              -configuration_basename $(arg cartographer_config)">
    <!-- Keep WARN/ERROR diagnostics while suppressing per-constraint INFO
         output from Cartographer's glog backend. -->
    <env name="GLOG_minloglevel" value="1"/>
    <remap from="scan" to="$(arg cartographer_scan_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node" output="screen"
        args="-resolution 0.05 -publish_period_sec 2.0"/>

  <node pkg="my_navigation" type="local_grid_mapper"
        name="local_grid_mapper" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="output_topic" value="/local_occupancy_grid"/>
    <param name="map_output_topic" value="/local_occupancy_grid_map"/>
    <param name="base_frame" value="base_link"/>
    <param name="map_frame" value="map"/>
    <param name="publish_map_frame_grid" value="true"/>
    <param name="map_size" value="5.0"/>
    <param name="resolution" value="0.05"/>
    <param name="max_range" value="5.0"/>
    <param name="tf_timeout" value="0.10"/>
    <param name="obstacle_dilation_cells" value="1"/>
  </node>

  <node if="$(arg enable_monitor)" pkg="my_navigation"
        type="mapping_health_monitor" name="mapping_health_monitor"
        output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="map_topic" value="/map"/>
    <param name="local_grid_topic" value="/local_occupancy_grid"/>
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="report_period" value="5.0"/>
    <param name="scan_min_hz" value="5.0"/>
    <!-- Enable only during a deliberate stationary test. -->
    <param name="enable_static_jitter_check" value="false"/>
    <param name="static_jitter_warn_m" value="0.08"/>
    <param name="static_yaw_warn_rad" value="0.08"/>
  </node>
</launch>
