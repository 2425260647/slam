# Reproducible experiment run products. Keep scripts, aggregate metrics,
# reports, and comparison figures at each experiment directory's top level.
paper_exp/**/runs/
paper_exp/**/runs_valid/
paper_exp/**/parameter_scan_runs/
paper_exp/**/reference_candidate_runs/
paper_exp/**/scan_configs/
paper_exp/formal_corridor_*/partial_precheck/
paper_exp/formal_corridor_*/missing_wall_stage_check/
paper_exp/formal_corridor_*/repeat_*_clean_baseline/

# Raw experiment streams and process logs remain local. Version reports,
# metrics, maps, plots, configurations and scripts instead.
paper_exp/**/*.bag
paper_exp/**/*.bag.active
paper_exp/**/*.csv
paper_exp/**/*.stdout
paper_exp/**/*.stderr
paper_exp/**/*.err
paper_exp/**/*.pid
paper_exp/**/*.active
paper_exp/**/ros_home/
paper_exp/**/log/
paper_exp/**/logs/
paper_exp/**/map_sample.txt

# Large manuscript figure exports; PNG/SVG sources remain versioned.
docs/paper_assets/*.pdf
docs/paper_assets/*.tiff
